/* Replace the AmigaGPT installer block in AmiKit KIT-Startup */
OPTIONS RESULTS

KITFILE = 'SYS:Prefs/Presets/AmiKit/KIT/KIT-Startup'
TEMPFILE = 'T:KIT-Startup.amigagpt'
BEGINMK = ';BEGIN AMIGAGPT-INSTALLER'
ENDMK = ';END AMIGAGPT-INSTALLER'
DAEMON = 'SYS:Prefs/Presets/AmiKit/KIT/AmigaGPTD'

DEST = ''
IF OPEN('env', 'ENV:AMIGAGPT_DEST', 'READ') THEN DO
  DEST = STRIP(READLN('env'))
  CALL CLOSE 'env'
END
IF DEST = '' THEN EXIT 1

STARTDAEMON = '0'
IF OPEN('env', 'ENV:AMIGAGPT_STARTDAEMON', 'READ') THEN DO
  STARTDAEMON = STRIP(READLN('env'))
  CALL CLOSE 'env'
END

IF \OPEN('out', TEMPFILE, 'WRITE') THEN EXIT 1

LAST = ''
IF OPEN('in', KITFILE, 'READ') THEN DO
  SKIPPING = 0
  DO WHILE \EOF('in')
    LINE = READLN('in')
    IF LINE = BEGINMK THEN SKIPPING = 1
    IF SKIPPING = 0 THEN DO
      CALL WRITELN 'out', LINE
      LAST = LINE
    END
    IF LINE = ENDMK THEN SKIPPING = 0
  END
  CALL CLOSE 'in'
END

IF LAST \= '' THEN CALL WRITELN 'out', ''

CALL WRITELN 'out', BEGINMK
CALL WRITELN 'out', '; --- Added by the AmigaGPT installer'
CALL WRITELN 'out', 'IF EXISTS "'DEST'"'
CALL WRITELN 'out', '   C:Assign >NIL: AMIGAGPT: "'DEST'"'
IF STARTDAEMON = '1' THEN DO
  CALL WRITELN 'out', '   IF EXISTS 'DAEMON
  CALL WRITELN 'out', '      Run <>NIL: 'DAEMON' <>NIL:'
  CALL WRITELN 'out', '   ENDIF'
END
CALL WRITELN 'out', 'ENDIF'
CALL WRITELN 'out', ENDMK
CALL CLOSE 'out'

ADDRESS COMMAND 'C:Copy >NIL: 'TEMPFILE' "'KITFILE'"'
COPYRC = RC
ADDRESS COMMAND 'C:Delete >NIL: 'TEMPFILE' FORCE QUIET'
IF COPYRC \= 0 THEN EXIT 1
EXIT 0
